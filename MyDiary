       -------------------------------------------------------------------------- */
    function formatToDateTimeLocal(date) {
      const pad = (n) => String(n).padStart(2, '0');
      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
    }

    function initCustomDatePicker() {
      const now = new Date();
      if (customEntryDate) {
        customEntryDate.value = formatToDateTimeLocal(now);
        customEntryDate.addEventListener('input', checkFutureDateStatus);
      }
      if (resetCurrentTimeBtn) {
        resetCurrentTimeBtn.addEventListener('click', () => {
          customEntryDate.value = formatToDateTimeLocal(new Date());
          checkFutureDateStatus();
          showToast('Tarikh ditetapkan ke waktu semasa.');
        });
      }
      checkFutureDateStatus();
    }

    function checkFutureDateStatus() {
      if (!customEntryDate || !customEntryDate.value) return;
      const selectedDate = new Date(customEntryDate.value);
      const isFuture = selectedDate.getTime() > Date.now();

      if (futureStatusBadge) {
        futureStatusBadge.style.display = isFuture ? 'inline-flex' : 'none';
      }

      if (editorHeaderDate) {
        const dateStr = selectedDate.toLocaleDateString('ms-MY', { 
          day: 'numeric', 
          month: 'short', 
          year: 'numeric', 
          hour: '2-digit', 
          minute: '2-digit' 
        });
        editorHeaderDate.textContent = isFuture ? `${dateStr} (Rancangan Hadapan)` : dateStr;
      }
    }

    /* --------------------------------------------------------------------------
       KALENDAR INTERAKTIF
       -------------------------------------------------------------------------- */
    function renderCalendar() {
      if (!calendarDaysGrid) return;
      calendarDaysGrid.innerHTML = '';

      const year = calendarDateCursor.getFullYear();
      const month = calendarDateCursor.getMonth();

      const monthNames = [
        'Januari', 'Februari', 'Mac', 'April', 'Mei', 'Jun',
        'Julai', 'Ogos', 'September', 'Oktober', 'November', 'Disember'
      ];
      if (calendarMonthYear) calendarMonthYear.textContent = `${monthNames[month]} ${year}`;

      const firstDayIndex = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const today = new Date();

      for (let i = 0; i < firstDayIndex; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'cal-day empty';
        calendarDaysGrid.appendChild(emptyCell);
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const cell = document.createElement('div');
        cell.className = 'cal-day';
        cell.textContent = day;

        const cellDateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const isToday = today.getFullYear() === year && today.getMonth() === month && today.getDate() === day;
        if (isToday) cell.classList.add('today');

        const entriesOnDate = journalEntries.filter(e => {
          const eDate = new Date(e.timestamp);
          const eStr = `${eDate.getFullYear()}-${String(eDate.getMonth() + 1).padStart(2, '0')}-${String(eDate.getDate()).padStart(2, '0')}`;
          return eStr === cellDateStr;
        });

        if (entriesOnDate.length > 0) {
          cell.classList.add('has-entry');
          const hasFutureEntry = entriesOnDate.some(e => new Date(e.timestamp).getTime() > Date.now());
          if (hasFutureEntry) cell.classList.add('is-future');
        }

        if (currentFilteredDate === cellDateStr) {
          cell.classList.add('active-filter');
        }

        cell.addEventListener('click', () => {
          if (currentFilteredDate === cellDateStr) {
            currentFilteredDate = null;
            if (resetCalFilterBtn) resetCalFilterBtn.style.display = 'none';
          } else {
            currentFilteredDate = cellDateStr;
            if (resetCalFilterBtn) resetCalFilterBtn.style.display = 'inline-block';

            const now = new Date();
            customEntryDate.value = `${cellDateStr}T${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
            checkFutureDateStatus();
            openArchiveDropside();
          }
          renderCalendar();
          renderEntries();
        });

        calendarDaysGrid.appendChild(cell);
      }
    }

