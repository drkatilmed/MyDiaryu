.confetti-1 { left: 8%; background: #ffeb3b; animation-delay: 0.1s; transform: rotate(15deg); }
    .confetti-2 { left: 22%; background: #00e676; animation-delay: 0.7s; transform: rotate(-25deg); width: 6px; height: 10px; }
    .confetti-3 { left: 38%; background: #ff4081; animation-delay: 1.2s; transform: rotate(35deg); }
    .confetti-4 { left: 55%; background: #00e5ff; animation-delay: 0.4s; transform: rotate(-10deg); }
    .confetti-5 { left: 74%; background: #ffea00; animation-delay: 1.5s; transform: rotate(45deg); width: 10px; height: 10px; border-radius: 50%; }
