    function loadEntriesFromStorage() {
      const saved = localStorage.getItem('mydiary_entries');
      if (saved) {
        try {
          journalEntries = JSON.parse(saved);
        } catch (e) {
          journalEntries = [];
        }
      }
      updateDashboardCounts();
    }

    function saveEntriesToStorage() {
      localStorage.setItem('mydiary_entries', JSON.stringify(journalEntries));
      updateDashboardCounts();
    }

    function updateDashboardCounts() {
      if (totalEntriesCount) totalEntriesCount.textContent = journalEntries.length;
      if (headerArchiveCount) headerArchiveCount.textContent = journalEntries.length;
      if (floatingCountBadge) floatingCountBadge.textContent = journalEntries.length;
      if (archiveTotalBadge) archiveTotalBadge.textContent = journalEntries.length;

      let photosTotal = 0;
      let audioTotal = 0;
      let futureTotal = 0;
      const now = Date.now();

      journalEntries.forEach(e => {
        if (e.photos) photosTotal += e.photos.length;
        if (e.audios) audioTotal += e.audios.filter(a => a !== null).length;
        if (new Date(e.timestamp).getTime() > now) futureTotal++;
      });

      if (totalPhotosCount) totalPhotosCount.textContent = photosTotal;
      if (totalAudioCount) totalAudioCount.textContent = audioTotal;
      if (futureEntriesCount) futureEntriesCount.textContent = futureTotal;
    }

    function createEntryObject() {
      const title = entryTitleInput.value.trim();
      const content = entryContentInput.value.trim();
      if (!title || !content) {
        showToast('Sila isikan tajuk dan kandungan catatan!');
        return null;
      }

      let timestamp;
      if (customEntryDate && customEntryDate.value) {
        timestamp = new Date(customEntryDate.value).toISOString();
      } else {
        timestamp = new Date().toISOString();
      }

      return {
        id: currentEditingEntryId ? currentEditingEntryId : ('entry_' + Date.now()),
        title: title,
        mood: entryMoodSelect.value,
        category: entryCategorySelect.value,
        content: content,
        photos: [...attachedPhotos],
        audios: [...attachedAudios],
        timestamp: timestamp
      };
    }

    function resetEditorForm() {
      currentEditingEntryId = null;
      journalEntryForm.reset();
      attachedPhotos = [];
      currentPhotoCursorIndex = 0;
      updatePhotoDropdownUI();

      attachedAudios = [null, null, null];
      switchAudioSlot(0);

      customEntryDate.value = formatToDateTimeLocal(new Date());
      checkFutureDateStatus();

      // Kembalikan UI ke mod catatan biasa
      if (editorMainTitle) editorMainTitle.innerHTML = '<i class="fa-solid fa-pen-nib"></i> Coretan & Rancangan Baharu';
      if (submitBtnText) submitBtnText.textContent = 'Simpan Catatan';
      if (cancelEditBtn) cancelEditBtn.style.display = 'none';
      if (editModeIndicator) editModeIndicator.style.display = 'none';
    }

    /* --------------------------------------------------------------------------
       FUNGSI EDIT CATATAN SEMULA
       -------------------------------------------------------------------------- */
    window.startEditEntryRecord = function(id) {
      const entry = journalEntries.find(e => e.id === id);
      if (!entry) return;

      currentEditingEntryId = entry.id;

      // Masukkan data lama ke dalam borang
      entryTitleInput.value = entry.title || '';
      entryMoodSelect.value = entry.mood || '🌸 Tenang & Bahagia';
      entryCategorySelect.value = entry.category || 'Harian';
      entryContentInput.value = entry.content || '';

      if (entry.timestamp) {
        const d = new Date(entry.timestamp);
        customEntryDate.value = formatToDateTimeLocal(d);
      }
      checkFutureDateStatus();

      // Pulihkan gambar
      attachedPhotos = entry.photos ? [...entry.photos] : [];
      currentPhotoCursorIndex = 0;
      updatePhotoDropdownUI();

      // Pulihkan audio
      attachedAudios = [null, null, null];
      if (entry.audios && Array.isArray(entry.audios)) {
        for (let i = 0; i < 3; i++) {
          attachedAudios[i] = entry.audios[i] || null;
        }
      }
      switchAudioSlot(0);

      // Kemas kini Paparan Mod Suntingan (Visual UI)
      if (editorMainTitle) editorMainTitle.innerHTML = '<i class="fa-solid fa-pen-to-square"></i> Kemaskini Catatan';
      if (submitBtnText) submitBtnText.textContent = 'Kemaskini Catatan';
