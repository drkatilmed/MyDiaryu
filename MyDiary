      box-shadow: var(--shadow-sm);
    }

.donate-pill-btn:hover {
      background: var(--accent-color);
      color: #ffffff;
      transform: translateY(-2px);
    }

/* Toast Notification */
    #toastNotification {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: #18181b;
      color: #fff;
      padding: 0.6rem 1.25rem;
      border-radius: var(--radius-pill);
      font-size: 0.82rem;
      font-weight: 600;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      z-index: 2000;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
      opacity: 0;
      pointer-events: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

#toastNotification.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

/* Animasi */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

@keyframes rotateSunRays {
      from { transform: translate(-50%, -50%) rotate(0deg); }
      to { transform: translate(-50%, -50%) rotate(360deg); }
    }

@keyframes pulse {
      from { opacity: 1; }
      to { opacity: 0.6; }
    }

/* Animasi Baru: Joy & Happy Go Lucky */
    @keyframes joyGradientFlow {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

@keyframes happyBounce {
      0% {
        transform: translateY(0) scale(1, 1);
      }
      60% {
        transform: translateY(-20px) scale(0.95, 1.05);
      }
      100% {
        transform: translateY(-24px) scale(1.05, 0.95) rotate(6deg);
      }
    }

@keyframes confettiFlutter {
      0% {
        top: -15%;
        transform: translateY(0) rotate(0deg) scale(0.8);
        opacity: 0.9;
      }
      50% {
        transform: translateY(60px) rotate(180deg) scale(1.1);
        opacity: 1;
      }
      100% {
        top: 110%;
        transform: translateY(120px) rotate(360deg) scale(0.7);
        opacity: 0;
      }
    }

@keyframes balloonFloat {
      0% {
        transform: translateY(0) rotate(-4deg);
      }
      100% {
        transform: translateY(-18px) rotate(6deg);
      }
    }

@keyframes happyPillWiggle {
