        if (currentEditingEntryId) {
          // Mod Kemas Kini (Update sedia ada)
          const index = journalEntries.findIndex(item => item.id === currentEditingEntryId);
          if (index !== -1) {
            journalEntries[index] = entryData;
            showToast('Catatan berjaya dikemaskini!');
