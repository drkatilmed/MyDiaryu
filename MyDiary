       -------------------------------------------------------------------------- */
    if (openCameraModalBtn) {
      openCameraModalBtn.addEventListener('click', async () => {
        if (attachedPhotos.length >= 10) {
          showToast('Maksimum 10 foto sudah dicapai!');
          return;
        }
        cameraModal.classList.add('active');
        await startCameraStream(currentFacingMode);
      });
    }

    if (closeCameraModalBtn) {
      closeCameraModalBtn.addEventListener('click', stopCameraStream);
    }

    async function startCameraStream(facing) {
      try {
        if (cameraMediaStream) {
          cameraMediaStream.getTracks().forEach(track => track.stop());
        }
        const constraints = {
          video: {
            facingMode: { ideal: facing },
            width: { ideal: 1280 },
            height: { ideal: 720 }
          },
          audio: false
        };
        cameraMediaStream = await navigator.mediaDevices.getUserMedia(constraints);
        cameraVideo.srcObject = cameraMediaStream;
      } catch (err) {
        showToast('Gagal mengakses kamera: ' + err.message);
        stopCameraStream();
      }
    }

    function stopCameraStream() {
      if (cameraMediaStream) {
        cameraMediaStream.getTracks().forEach(track => track.stop());
        cameraMediaStream = null;
      }
      cameraModal.classList.remove('active');
    }

    if (flipCameraBtn) {
      flipCameraBtn.addEventListener('click', async () => {
        currentFacingMode = currentFacingMode === 'environment' ? 'user' : 'environment';
        await startCameraStream(currentFacingMode);
      });
    }

    if (takePhotoShutterBtn) {
      takePhotoShutterBtn.addEventListener('click', () => {
        if (!cameraVideo.srcObject) return;
        const vWidth = cameraVideo.videoWidth || 640;
        const vHeight = cameraVideo.videoHeight || 480;
        
        const squareSize = Math.min(vWidth, vHeight);
        const startX = (vWidth - squareSize) / 2;
        const startY = (vHeight - squareSize) / 2;

        const canvas = document.createElement('canvas');
        canvas.width = squareSize;
        canvas.height = squareSize;
        const ctx = canvas.getContext('2d');
        
        ctx.drawImage(
          cameraVideo,
          startX, startY, squareSize, squareSize,
          0, 0, squareSize, squareSize
        );
        
        const dataUrl = canvas.toDataURL('image/jpeg', 0.9);

        attachedPhotos.push(dataUrl);
        currentPhotoCursorIndex = attachedPhotos.length - 1;
        updatePhotoDropdownUI();
        stopCameraStream();
        showToast('Foto saiz 1:1 berjaya ditangkap!');
      });
    }

