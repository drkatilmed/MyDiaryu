<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>MyDiary - Personal Memory & Life Archive</title>

<!-- Google Fonts: Inter, Syne, Playfair Display & Fira Code -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">

<!-- Font Awesome untuk Ikon Grafik -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<style>
    /* ==========================================================================
       SISTEM TEMA VANILLA CSS & REKA BENTUK RESPONSIF
       ========================================================================== */
    :root {
      /* Tema Lalai: French Pink */
      --bg-canvas: #fff5f8;
      --bg-panel: #ffffff;
      --bg-card: #ffffff;
      --border-color: #ffd1df;
      --border-focus: #fd6c9e;
      --text-main: #3b1828;
      --text-muted: #8c5369;
      --accent-color: #fd6c9e;
      --accent-hover: #e64980;
      --accent-soft: #ffe3ec;
      --shadow-sm: 0 2px 4px rgba(253, 108, 158, 0.08);
      --shadow-md: 0 4px 14px rgba(253, 108, 158, 0.12);
      --shadow-lg: 0 10px 25px rgba(253, 108, 158, 0.18);
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-title: 'Syne', sans-serif;
      --font-serif: 'Playfair Display', Georgia, serif;
      --font-mono: 'Fira Code', monospace;
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 16px;
      --radius-pill: 9999px;
      --transition-fast: 0.15s ease;
      --transition-normal: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

/* Tema Biru Navy */
    body.theme-navy {
      --bg-canvas: #0b1329;
      --bg-panel: #111d42;
      --bg-card: #182859;
      --border-color: #243b7d;
      --border-focus: #4d77ff;
      --text-main: #edf2f7;
      --text-muted: #94a9d4;
      --accent-color: #3b82f6;
      --accent-hover: #2563eb;
      --accent-soft: rgba(59, 130, 246, 0.18);
      --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.4);
      --shadow-md: 0 4px 14px rgba(0, 0, 0, 0.5);
      --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.6);
    }

/* Tema Hitam Karbon & Aksen Emas */
    body.theme-black {
      --bg-canvas: #09090b;
      --bg-panel: #121215;
      --bg-card: #18181d;
      --border-color: #27272a;
      --border-focus: #eab308;
      --text-main: #fafafa;
      --text-muted: #a1a1aa;
      --accent-color: #eab308;
      --accent-hover: #ca8a04;
      --accent-soft: rgba(234, 179, 8, 0.15);
      --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.6);
      --shadow-md: 0 4px 14px rgba(0, 0, 0, 0.7);
      --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.8);
    }

/* Reset & Asas Dokumen */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

html, body {
      min-height: 100%;
      width: 100%;
      background-color: var(--bg-canvas);
      color: var(--text-main);
      font-family: var(--font-body);
      line-height: 1.5;
      transition: background-color var(--transition-normal), color var(--transition-normal);
      overflow-x: hidden;
      padding-top: env(safe-area-inset-top);
      padding-bottom: env(safe-area-inset-bottom);
      padding-left: env(safe-area-inset-left);
      padding-right: env(safe-area-inset-right);
    }

/* Canvas Debu Emas Berterbangan */
    #dustCanvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 0;
    }

.app-wrapper {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      max-width: 1440px;
      margin: 0 auto;
      padding: 0.75rem;
    }

/* Pengepala (Header) */
    header.main-header {
      background: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 0.85rem 1.25rem;
      margin-bottom: 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      box-shadow: var(--shadow-sm);
    }

.brand-section {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

.brand-logo-img {
      width: 46px;
      height: 46px;
      border-radius: var(--radius-md);
      object-fit: cover;
      border: 2px solid var(--accent-color);
      box-shadow: 0 0 10px var(--accent-soft);
      transition: transform var(--transition-normal);
    }

.brand-logo-img:hover {
      transform: scale(1.05) rotate(2deg);
    }

.brand-title {
      font-family: var(--font-title);
      font-size: 1.5rem;
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

.brand-title span.diary-text {
      font-family: var(--font-serif);
      font-weight: 600;
      font-style: italic;
      color: var(--accent-color);
      margin-left: 2px;
    }

.brand-subtitle {
      font-size: 0.72rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-weight: 600;
    }

.header-controls {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

/* Jam Digital & Widget Waktu Solat Terdekat Beranimasi */
    .time-prayer-cluster {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

.live-clock-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      gap: 0.65rem;
      box-shadow: var(--shadow-sm);
      transition: all var(--transition-fast);
    }

.live-clock-card:hover {
      border-color: var(--accent-color);
      box-shadow: 0 0 12px var(--accent-soft);
    }

.clock-digits-group {
      display: flex;
      align-items: baseline;
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--text-main);
      line-height: 1;
    }

.clock-main-time {
      font-size: 1.15rem;
      letter-spacing: 0.04em;
    }

.clock-sec-badge {
      font-size: 0.68rem;
      color: var(--accent-color);
      margin-left: 2px;
      font-weight: 800;
    }

.clock-date-sub {
      font-size: 0.65rem;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: capitalize;
      border-left: 1px solid var(--border-color);
      padding-left: 0.5rem;
      display: flex;
      flex-direction: column;
    }

/* Widget Waktu Solat Terdekat */
    .prayer-live-badge {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.75rem;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      transition: all var(--transition-fast);
      position: relative;
    }

.prayer-live-badge:hover {
      border-color: #10b981;
      background: rgba(16, 185, 129, 0.08);
    }

.prayer-icon-glow {
      color: #10b981;
      font-size: 0.85rem;
      animation: pulse 1.5s infinite alternate;
    }

.prayer-info-block {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
    }

.prayer-name-tag {
      font-weight: 800;
      color: var(--text-main);
      font-size: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

.prayer-time-val {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--accent-color);
      font-size: 0.78rem;
    }

.prayer-count-down {
      font-size: 0.63rem;
      color: var(--text-muted);
    }

.theme-selector-wrapper {
      position: relative;
    }

.action-btn-header {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 0.45rem 0.85rem;
      border-radius: var(--radius-pill);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all var(--transition-fast);
      touch-action: manipulation;
    }

.action-btn-header:hover {
      border-color: var(--accent-color);
      color: var(--accent-color);
      background: var(--accent-soft);
    }

.theme-menu {
      position: absolute;
      top: 120%;
      right: 0;
      background: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
      padding: 0.5rem;
      display: none;
      flex-direction: column;
      gap: 0.35rem;
      min-width: 170px;
      z-index: 100;
    }

.theme-menu.active {
      display: flex;
      animation: fadeIn 0.2s ease forwards;
    }

.theme-menu-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.8rem;
      color: var(--text-main);
      background: none;
      border: none;
      border-radius: var(--radius-sm);
      cursor: pointer;
      text-align: left;
      width: 100%;
      transition: background var(--transition-fast);
    }

.theme-menu-item:hover {
      background: var(--accent-soft);
    }

.color-swatch {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.4);
    }

/* Susun Atur Utama (Grid Workspace) */
    .journal-grid {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 1rem;
      flex: 1;
      align-items: start;
    }

.panel {
      background: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 1.15rem;
      box-shadow: var(--shadow-sm);
    }

.panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: 0.65rem;
      border-bottom: 1px solid var(--border-color);
    }

.panel-title {
      font-size: 0.95rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      letter-spacing: -0.01em;
    }

.panel-title i {
      color: var(--accent-color);
    }

/* Kalendar Mini & Motivasi */
    .quote-box {
      background: var(--bg-canvas);
      border-left: 3px solid var(--accent-color);
      padding: 0.75rem;
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      margin-bottom: 1rem;
      font-size: 0.82rem;
      font-style: italic;
    }

.quote-box p {
      color: var(--text-main);
      margin-bottom: 0.25rem;
    }

.quote-box span {
      font-size: 0.7rem;
      color: var(--accent-color);
      font-weight: 600;
      display: block;
      text-align: right;
    }

.calendar-container {
      margin-bottom: 1rem;
    }

.calendar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.65rem;
      font-size: 0.85rem;
      font-weight: 700;
    }

.cal-btn {
      background: var(--bg-canvas);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      width: 28px;
      height: 28px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all var(--transition-fast);
    }

.cal-btn:hover {
      background: var(--accent-color);
      color: #fff;
    }

.calendar-weekdays {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      text-align: center;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 0.35rem;
    }

.calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 3px;
    }

.cal-day {
      aspect-ratio: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all var(--transition-fast);
      position: relative;
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-main);
    }

.cal-day:hover {
      background: var(--accent-soft);
    }

.cal-day.empty {
      cursor: default;
      background: transparent !important;
    }

.cal-day.today {
      border-color: var(--accent-color);
      font-weight: 800;
    }

.cal-day.active-filter {
      background: var(--accent-color) !important;
      color: #fff !important;
      font-weight: 700;
    }

.cal-day.has-entry::after {
      content: '';
      position: absolute;
      bottom: 2px;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--accent-color);
    }

.cal-day.has-entry.is-future::after {
      background: #3b82f6;
    }

.cal-day.active-filter::after {
      background: #ffffff !important;
    }

/* Statistik Penulisan - Digayakan khusus di dalam Arkib Dropside */
    .archive-stats-box {
      background: var(--bg-canvas);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.75rem;
      margin: 0.85rem 1.15rem 0.25rem 1.15rem;
    }

.archive-stats-header {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

.archive-stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.4rem;
    }

.stat-item {
      background: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.4rem 0.2rem;
      text-align: center;
    }

.stat-number {
      font-family: var(--font-title);
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--accent-color);
      line-height: 1.1;
    }

.stat-label {
      font-size: 0.62rem;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 700;
      margin-top: 2px;
    }

/* Editor Catatan Jurnal */
    .editor-form {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

.input-field {
      width: 100%;
      background: var(--bg-canvas);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.65rem 0.85rem;
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 0.88rem;
      outline: none;
      transition: border var(--transition-fast), box-shadow var(--transition-fast);
    }

.input-field:focus {
      border-color: var(--accent-color);
      box-shadow: 0 0 0 3px var(--accent-soft);
    }

.title-input {
      font-size: 1.05rem;
      font-weight: 700;
    }

.content-textarea {
      min-height: 160px;
      resize: vertical;
      line-height: 1.6;
    }

.meta-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.65rem;
    }

/* Media Uploader & Dropdown Cursor */
    .media-card {
      background: var(--bg-canvas);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.85rem;
    }

.media-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
      font-weight: 700;
      margin-bottom: 0.6rem;
    }

.media-btn-row {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }

.file-input-hidden {
      display: none;
    }

.media-action-btn {
      background: var(--bg-panel);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 0.35rem 0.65rem;
      border-radius: var(--radius-sm);
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      transition: all var(--transition-fast);
    }

.media-action-btn:hover {
      border-color: var(--accent-color);
      color: var(--accent-color);
    }

/* Photo Dropdown Cursor Preview */
    .photo-dropdown-container {
      display: none;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 0.65rem;
      background: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.65rem;
    }

.dropdown-cursor-bar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

.cursor-nav-btn {
      background: var(--bg-canvas);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      width: 26px;
      height: 26px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 0.7rem;
    }

.image-preview-stage {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      max-height: 380px;
      border-radius: var(--radius-md);
      overflow: hidden;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto;
    }

.image-preview-stage img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      cursor: zoom-in;
    }

/* Audio Recording Multi-Slot (3 Slot) */
    .audio-slots-tabs {
      display: flex;
      gap: 0.3rem;
      margin-bottom: 0.6rem;
    }

.audio-tab-btn {
      flex: 1;
      padding: 0.3rem;
      background: var(--bg-panel);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
    }

.audio-tab-btn.active {
      background: var(--accent-soft);
      border-color: var(--accent-color);
      color: var(--accent-color);
    }

.audio-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #ccc;
    }

.audio-dot.filled {
      background: #10b981;
    }

.audio-controls-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

.record-btn {
      background: #ef4444;
      color: #fff;
      border: none;
      padding: 0.4rem 0.8rem;
      border-radius: var(--radius-pill);
      font-size: 0.75rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

.record-btn.recording {
      animation: pulse 1s infinite alternate;
      background: #b91c1c;
    }

/* Indikator Mod Suntingan (Edit Mode Indicator) */
    .edit-mode-indicator {
      display: none;
      align-items: center;
      justify-content: space-between;
      background: var(--accent-soft);
      border: 1px dashed var(--accent-color);
      padding: 0.5rem 0.85rem;
      border-radius: var(--radius-md);
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--accent-color);
      animation: fadeIn 0.2s ease;
    }

/* Butang Hantar & Aksi Simpan */
    .form-submit-row {
      display: flex;
      gap: 0.65rem;
      flex-wrap: wrap;
    }

.btn-submit-primary {
      flex: 1;
      background: var(--accent-color);
      color: #ffffff;
      border: none;
      padding: 0.75rem 1rem;
      border-radius: var(--radius-md);
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      box-shadow: var(--shadow-sm);
      transition: background var(--transition-fast), transform var(--transition-fast);
      touch-action: manipulation;
    }

.btn-submit-primary:hover {
      background: var(--accent-hover);
      transform: translateY(-1px);
    }

.btn-submit-gcal {
      background: var(--bg-panel);
      border: 1px solid #4285f4;
      color: #4285f4;
      padding: 0.75rem 1rem;
      border-radius: var(--radius-md);
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      transition: all var(--transition-fast);
      touch-action: manipulation;
    }

.btn-submit-gcal:hover {
      background: #4285f4;
      color: #fff;
    }

.btn-cancel-edit {
      display: none;
      background: var(--bg-panel);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      padding: 0.75rem 1rem;
      border-radius: var(--radius-md);
      font-size: 0.85rem;
